# Family Travel Site — client env (Vite)
# Copy to .env.local and fill from the same Supabase project as the iOS app.
# Never commit real keys. Never use the service-role key here.
#
# Local run (no Nest):
#   1. Fill URL + anon key below (VITE_DATA_PLANE defaults to supabase if unset)
#   2. From repo root: npm run dev  (alias: npm run dev:web)
#   3. Open http://localhost:5173 and sign in with your Family Travel email/password
#
# Legacy TREK / SQLite: npm run dev:nest  (sets VITE_DATA_PLANE=nest)

# nest = legacy TREK /api proxy (opt-in via npm run dev:nest)
# supabase = Family Travel Auth + RLS (default when unset)
VITE_DATA_PLANE=supabase

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# W3+ Mapbox GL (default on supabase plane). Optional — Leaflet is used if unset.
VITE_MAPBOX_ACCESS_TOKEN=
