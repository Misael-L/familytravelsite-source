    "heic-to": "1.5.2",
    "jszip": "3.10.1",
    "pdfjs-dist": "6.2.108",
    "react": "19.3.0"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
