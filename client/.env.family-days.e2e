# Fake public credentials for the isolated Days presentation browser run.
# Vite mode family-days.e2e. Nothing listens on port 5199; Playwright fulfills it.
# Do not put a real anon key, service-role key, or production URL in this file.
VITE_DATA_PLANE=supabase
VITE_SUPABASE_URL=http://127.0.0.1:5199
VITE_SUPABASE_ANON_KEY=family-days-e2e-public-anon
VITE_MAPBOX_ACCESS_TOKEN=pk.family-public-fixture
