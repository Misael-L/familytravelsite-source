+async function withDeviceCovers(trips: FamilyDashboardTrip[]): Promise<FamilyDashboardTrip[]> {
+  try {
+    const covers = await readTripCoverUrls(trips.filter(trip => !trip.cover_image).map(trip => trip.id))
+    return trips.map(trip => {
+      const cover = covers.get(trip.id)
+      return cover ? { ...trip, cover_image: cover } : trip
+    })
+  } catch {
+    return trips
+  }
